@page "{idPantalla:int}"
@model ServiciosMedicos.Pages.Pantallas.EditarModel

@{
    ViewData["Title"] = "Editar Pantalla";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-bold mb-1">Editar Pantalla</h2>
    <hr class="mb-3">

    <form method="post" class="row g-3">
        <input asp-for="Pantalla.IdPantalla" type="hidden" />

        <div class="col-md-6">
            <label class="form-label">Nombre Pantalla</label>
            <input asp-for="Pantalla.NombrePantalla" class="form-control" />
        </div>

        <div class="col-md-6 d-flex align-items-end">
            <div class="form-check mb-0">
                <input asp-for="Pantalla.Activo" class="form-check-input" />
                <label class="form-check-label">Activo</label>
            </div>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-success">Guardar</button>
            <a asp-page="Index" class="btn btn-secondary">Regresar</a>
        </div>
    </form>
</div>
