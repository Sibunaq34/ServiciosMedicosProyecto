@page
@model ServiciosMedicos.Pages.Pantallas.CrearModel

<h2>Crear Pantalla</h2>

<form method="post">

    <div class="mb-3">
        <label class="form-label">
            Nombre Pantalla
        </label>

        <input asp-for="Pantalla.NombrePantalla"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-success">
        Guardar
    </button>

    <a asp-page="Index"
       class="btn btn-secondary">
        Volver
    </a>

</form>