@page
@model Servicios_Medicos.Pages.AccionesPersonal.IndexModel

@{
    ViewData["Title"] = "Acciones de Personal";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-bold mb-1">Acciones de Personal</h2>
    <hr class="mb-3">

    <a asp-page="Create" class="btn btn-primary mb-3">Nueva Acción</a>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead style="background-color:#1a2e42;">
                <tr>
                    <th class="text-white">Código</th>
                    <th class="text-white">Fecha</th>
                    <th class="text-white">Empleado</th>
                    <th class="text-white">Jefatura</th>
                    <th class="text-white">Descripción</th>
                    <th class="text-white">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ListaAcciones)
                {
                    <tr>
                        <td>@item.CodigoAccion</td>
                        <td>@item.FechaAccion.ToString("dd/MM/yyyy")</td>
                        <td>@item.Empleado</td>
                        <td>@item.Jefatura</td>
                        <td>@item.Descripcion</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button"
                                        class="btn btn-sm"
                                        style="background-color:#5BBFFF; color:#12375C;"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEliminarAccion"
                                        data-id="@item.IdAccion"
                                        data-codigo="@item.CodigoAccion">
                                    Eliminar
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.ListaAcciones.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No hay acciones de personal registradas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav aria-label="Paginacion de acciones de personal">
            <ul class="pagination flex-wrap">
                <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="Index" asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                </li>
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" asp-page="Index" asp-route-pagina="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-page="Index" asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>

<div class="modal fade" id="modalEliminarAccion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Eliminar">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    ¿Realmente desea eliminar el elemento seleccionado?
                    <p class="fw-semibold mt-2 mb-0" id="codigoAccionEliminar"></p>
                    <input type="hidden" name="id" id="idAccionEliminar" />
                    <input type="hidden" name="pagina" value="@Model.PaginaActual" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model.Mensaje != null)
{
    <div class="modal fade" id="modalResultado" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-@Model.TipoMensaje text-white">
                    <h5 class="modal-title">@(Model.TipoMensaje == "success" ? "Éxito" : "Error")</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">@Model.Mensaje</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const modalEliminarAccion = document.getElementById('modalEliminarAccion');

        if (modalEliminarAccion) {
            modalEliminarAccion.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('idAccionEliminar').value = button.getAttribute('data-id');
                document.getElementById('codigoAccionEliminar').textContent = button.getAttribute('data-codigo');
            });
        }

        @if (Model.Mensaje != null)
        {
            <text>
                window.addEventListener('load', function () {
                    new bootstrap.Modal(document.getElementById('modalResultado')).show();
                });
            </text>
        }
    </script>
}
