@page
@model Servicios_Medicos.Pages.AccionesPersonal.CreateModel

<div class="container mt-4">

    <h2>Nueva Acción de Personal</h2>

    <form method="post">

        <div class="mb-3">

            <label>Fecha</label>

            <input asp-for="Accion.FechaAccion"
                   type="date"
                   class="form-control" />

        </div>

        <div class="mb-3">

            <label>Empleado</label>

            <select asp-for="Accion.IdEmpleado"
                    asp-items="Model.Empleados"
                    class="form-control">

                <option value="">
                    Seleccione...
                </option>

            </select>

        </div>

        <div class="mb-3">

            <label>Jefatura</label>

            <select asp-for="Accion.IdJefatura"
                    asp-items="Model.Empleados"
                    class="form-control">

                <option value="">
                    Seleccione...
                </option>

            </select>

        </div>

        <div class="mb-3">

            <label>Descripción</label>

            <textarea asp-for="Accion.Descripcion"
                      class="form-control">
            </textarea>

        </div>

        <button type="submit"
                class="btn btn-success">
            Guardar
        </button>

    </form>

</div>