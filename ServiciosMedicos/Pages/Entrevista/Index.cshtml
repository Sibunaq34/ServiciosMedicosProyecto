@page
@model ServiciosMedicos.Pages.Entrevista.IndexModel
@{
    ViewData["Title"] = "Agenda de Entrevistas";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-bold mb-1">Agenda de Entrevistas</h2>
    <hr class="mb-3">

    <a class="btn btn-primary mb-3" asp-page="Agendar">Agendar</a>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead style="background-color:#1a2e42;">
                <tr>
                    <th class="text-white">Oferente</th>
                    <th class="text-white">Entrevistador</th>
                    <th class="text-white">Fecha</th>
                    <th class="text-white">Estado</th>
                    <th class="text-white">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Entrevistas)
                {
                    <tr>
                        <td>@e.NombreOferente</td>
                        <td>@e.NombreEmpleado</td>
                        <td>@e.FechaEntrevista.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <span class="badge text-white" style="background-color:#1D6FA4;">
                                @e.Estado
                            </span>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @if (e.Estado == "Pendiente")
                                {
                                    <a class="btn btn-sm" style="background-color:#5BBFFF; color:#12375C;"
                                       asp-page="Editar"
                                       asp-route-id="@e.IdEntrevista">Cambiar datos</a>
                                }

                                <button class="btn btn-sm" style="background-color:#5BBFFF; color:#12375C;"
                                        onclick="confirmarEliminar(@e.IdEntrevista)">Eliminar</button>

                                @if (e.Estado == "Pendiente")
                                {
                                    <button class="btn btn-sm btn-success" style="background-color:#5BBFFF; color:#12375C;"
                                            onclick="confirmarRealizada(@e.IdEntrevista)">Marcar completada</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Entrevistas.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted">No hay entrevistas agendadas.</td></tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Paginacion de entrevistas">
        <ul class="pagination">
            <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-pagina="@(Model.PaginaActual - 1)">
                    Anterior
                </a>
            </li>
            <li class="page-item active" aria-current="page">
                <span class="page-link">@Model.PaginaActual</span>
            </li>
            <li class="page-item @(Model.PaginaActual < Model.TotalPaginas ? "" : "disabled")">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-pagina="@(Model.PaginaActual + 1)">
                    Siguiente
                </a>
            </li>
        </ul>
    </nav>
</div>

<!-- Modal confirmación eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">¿Realmente desea eliminar el elemento seleccionado?</div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar">
                    <input type="hidden" name="id" id="idEliminar" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal confirmación marcar realizada -->
<div class="modal fade" id="modalRealizada" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Marcar como completada</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">¿Desea marcar esta entrevista como realizada?</div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="MarcarRealizada">
                    <input type="hidden" name="id" id="idRealizada" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                    <button type="submit" class="btn btn-success">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal resultado -->
@if (Model.Mensaje != null)
{
    <div class="modal fade" id="modalResultado" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-@Model.TipoMensaje text-white">
                    <h5 class="modal-title">@(Model.TipoMensaje == "success" ? "Éxito" : "Error")</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">@Model.Mensaje</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function confirmarEliminar(id) {
            document.getElementById('idEliminar').value = id;
            new bootstrap.Modal(document.getElementById('modalEliminar')).show();
        }

        function confirmarRealizada(id) {
            document.getElementById('idRealizada').value = id;
            new bootstrap.Modal(document.getElementById('modalRealizada')).show();
        }

        @if (Model.Mensaje != null)
        {
            <text>
            window.addEventListener('load', function () {
                new bootstrap.Modal(document.getElementById('modalResultado')).show();
            });
            </text>
        }
    </script>
}
