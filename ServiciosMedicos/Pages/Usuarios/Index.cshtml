@page
@model ServiciosMedicos.Pages.Usuarios.IndexModel

@{
    ViewData["Title"] = "Administración de Usuarios";
}

<div class="container-fluid px-2 px-md-4 py-4">
    <h2 class="fw-bold mb-1">Administración de Usuarios</h2>
    <hr class="mb-3">

    <a asp-page="Crear" class="btn btn-primary mb-3 w-100 w-md-auto">
        Nuevo Usuario
    </a>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead style="background-color:#1a2e42;">
                <tr>
                    <th class="text-white">ID</th>
                    <th class="text-white">Usuario</th>
                    <th class="text-white">Nombre Completo</th>
                    <th class="text-white">Correo</th>
                    <th class="text-white">Rol</th>
                    <th class="text-white">Estado</th>
                    <th class="text-white">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.ListaUsuarios)
                {
                    <tr>
                        <td>@item.IdUsuario</td>
                        <td>@item.UsuarioNombre</td>
                        <td>@item.NombreCompleto</td>
                        <td>@item.Correo</td>
                        <td>@item.NombrePermiso</td>
                        <td>@item.Estado</td>

                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a asp-page="Editar"
                                   asp-route-idUsuario="@item.IdUsuario"
                                   class="btn btn-sm"
                                   style="background-color:#5BBFFF; color:#12375C;">
                                    Editar
                                </a>

                                <button type="button"
                                        class="btn btn-secondary btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEstadoUsuario"
                                        data-id="@item.IdUsuario"
                                        data-activo="@item.Activo.ToString().ToLower()">
                                    @(item.Activo ? "Inactivar" : "Activar")
                                </button>

                                <button type="button"
                                        class="btn btn-sm"
                                        style="background-color:#5BBFFF; color:#12375C;"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEliminarUsuario"
                                        data-id="@item.IdUsuario">
                                    Eliminar
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav>
        <ul class="pagination justify-content-start flex-wrap">
            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.Pagina ? "active" : "")">
                    <a class="page-link" asp-route-Pagina="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
</div>

<div class="modal fade" id="modalEliminarUsuario" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Eliminar">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">
                    <input type="hidden"
                           id="idUsuarioEliminar"
                           name="idUsuario" />

                    <p>¿Realmente desea eliminar el usuario seleccionado?</p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Confirmar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEstadoUsuario" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CambiarEstado">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">Confirmar Acción</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">
                    <input type="hidden"
                           id="idUsuarioEstado"
                           name="idUsuario" />

                    <input type="hidden"
                           id="activoUsuarioEstado"
                           name="activo" />

                    <p id="textoEstadoUsuario"></p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Confirmar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var modalEliminar =
            document.getElementById("modalEliminarUsuario");

        if (modalEliminar) {
            modalEliminar.addEventListener(
                "show.bs.modal",
                function (event) {
                    var button = event.relatedTarget;

                    document.getElementById("idUsuarioEliminar").value =
                        button.getAttribute("data-id");
                });
        }

        var modalEstado =
            document.getElementById("modalEstadoUsuario");

        if (modalEstado) {
            modalEstado.addEventListener(
                "show.bs.modal",
                function (event) {
                    var button = event.relatedTarget;
                    var id = button.getAttribute("data-id");
                    var activo = button.getAttribute("data-activo");

                    document.getElementById("idUsuarioEstado").value = id;
                    document.getElementById("activoUsuarioEstado").value = activo;

                    document.getElementById("textoEstadoUsuario").innerText =
                        activo === "true"
                            ? "¿Desea inactivar el usuario seleccionado?"
                            : "¿Desea activar el usuario seleccionado?";
                });
        }
    });
</script>