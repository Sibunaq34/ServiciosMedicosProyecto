@page
@model ServiciosMedicos.Pages.Compania.CrearModel
@{
    ViewData["Title"] = "Nueva Compañía";
}

<h2>Nueva Compañía</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMensaje))
{
    <div class="alert alert-danger">@Model.ErrorMensaje</div>
}

<form method="post" class="mt-3" style="max-width:500px">
    <div class="mb-3">
        <label class="form-label">Código de compañía <span class="text-danger">*</span></label>
        <input asp-for="CodigoCompania" class="form-control" maxlength="@Model.LongitudCodCompania" />
        <span asp-validation-for="CodigoCompania" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Nombre <span class="text-danger">*</span></label>
        <input asp-for="Nombre" class="form-control" maxlength="@Model.LongitudNombreCompania" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-page="Index" class="btn btn-secondary">Regresar</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
