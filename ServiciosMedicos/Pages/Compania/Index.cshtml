@page
@model ServiciosMedicos.Pages.Compania.IndexModel
@{
    ViewData["Title"] = "Administración de Compañías";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Administración de Compañías</h2>
    <a asp-page="Crear" class="btn btn-primary">Nuevo</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th class="text-center" style="width:160px">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Companias.Any())
        {
            <tr>
                <td colspan="3" class="text-center text-muted">No hay compañías registradas.</td>
            </tr>
        }
        @foreach (var c in Model.Companias)
        {
            <tr>
                <td>@c.CodigoCompania</td>
                <td>@c.Nombre</td>
                <td class="text-center">
                    <a asp-page="Editar" asp-route-id="@c.IdCompania" class="btn btn-sm btn-warning">Editar</a>
                    <button type="button" class="btn btn-sm btn-danger"
                            onclick="confirmarEliminar(@c.IdCompania, '@c.Nombre')">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@* Paginación *@
@if (Model.TotalPaginas > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                    <a class="page-link" asp-page="Index" asp-route-pagina="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}

@* Modal confirmación eliminar *@
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Realmente desea eliminar el elemento seleccionado?
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar">
                    <input type="hidden" name="id" id="idEliminar" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

@* Modal resultado (éxito / error) *@
@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="modal fade" id="modalResultado" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-@Model.TipoMensaje text-white">
                    <h5 class="modal-title">@(Model.TipoMensaje == "success" ? "Éxito" : "Error")</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">@Model.Mensaje</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function confirmarEliminar(id, nombre) {
            document.getElementById('idEliminar').value = id;
            new bootstrap.Modal(document.getElementById('modalEliminar')).show();
        }

        @if (!string.IsNullOrEmpty(Model.Mensaje))
        {
            <text>
            document.addEventListener('DOMContentLoaded', function () {
                new bootstrap.Modal(document.getElementById('modalResultado')).show();
            });
            </text>
        }
    </script>
}
