@page
@model ServiciosMedicos.Pages.ExperienciaLaboral.IndexModel
@{
    ViewData["Title"] = "Experiencia Laboral";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-bold mb-1">Experiencia Laboral — @Model.NombreOferente</h2>
    <hr class="mb-3">

    <a class="btn btn-primary mb-3" asp-page="Crear" asp-route-ofertanteId="@Model.OfertanteId">Nuevo</a>

    <table class="table table-bordered table-hover align-middle">
        <thead class="page-thead">
            <tr>
                <th>Empresa</th>
                <th>Puesto</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var exp in Model.Experiencias)
            {
                <tr>
                    <td>@exp.NombreEmpresa</td>
                    <td>@exp.PuestoDesempenado</td>
                    <td>@exp.FechaInicio.ToString("dd/MM/yyyy")</td>
                    <td>@exp.FechaFin.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a class="btn btn-sm me-1 text-white" style="background-color:#1D6FA4;"
                           asp-page="Editar"
                           asp-route-id="@exp.IdExperiencia">Editar</a>
                        <button class="btn btn-danger btn-sm"
                                onclick="confirmarEliminar(@exp.IdExperiencia)">Eliminar</button>
                    </td>
                </tr>
            }
            @if (!Model.Experiencias.Any())
            {
                <tr><td colspan="5" class="text-center text-muted">No hay experiencias laborales registradas.</td></tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPaginas > 1)
    {
        <nav>
            <ul class="pagination">
                <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-page="Index"
                       asp-route-ofertanteId="@Model.OfertanteId"
                       asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                </li>
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link"
                           asp-page="Index"
                           asp-route-ofertanteId="@Model.OfertanteId"
                           asp-route-pagina="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link"
                       asp-page="Index"
                       asp-route-ofertanteId="@Model.OfertanteId"
                       asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Modal confirmación eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Realmente desea eliminar el elemento seleccionado?
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar">
                    <input type="hidden" name="id" id="idEliminar" />
                    <input type="hidden" name="ofertanteId" value="@Model.OfertanteId" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal resultado -->
@if (Model.Mensaje != null)
{
    <div class="modal fade" id="modalResultado" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-@Model.TipoMensaje text-white">
                    <h5 class="modal-title">@(Model.TipoMensaje == "success" ? "Éxito" : "Error")</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">@Model.Mensaje</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function confirmarEliminar(id) {
            document.getElementById('idEliminar').value = id;
            new bootstrap.Modal(document.getElementById('modalEliminar')).show();
        }

        @if (Model.Mensaje != null)
        {
            <text>
            window.addEventListener('load', function () {
                new bootstrap.Modal(document.getElementById('modalResultado')).show();
            });
            </text>
        }
    </script>
}
