@page "{idPuesto:int}"
@model ServiciosMedicos.Pages.Requisitos.IndexModel

@{
    ViewData["Title"] = "Requisitos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">
        <h3>Requisitos del Puesto</h3>
        <a asp-page="Create" asp-route-idPuesto="@Model.IdPuesto" class="btn btn-success">
            Nuevo Requisito
        </a>
    </div>

    <table class="table table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Requisito</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ListaRequisitos)
            {
                <tr>
                    <td>@item.IdRequisito</td>
                    <td>@item.NombreRequisito</td>
                    <td>
                        <a asp-page="Edit"
                           asp-route-id="@item.IdRequisito"
                           asp-route-nombre="@item.NombreRequisito"
                           asp-route-idPuesto="@item.IdPuesto"
                           class="btn btn-warning btn-sm">
                            Editar
                        </a>
                        <form method="post" style="display:inline">
                            <button asp-page-handler="Eliminar"
                                    asp-route-id="@item.IdRequisito"
                                    asp-route-idPuesto="@Model.IdPuesto"
                                    class="btn btn-danger btn-sm"
                                    onclick="return confirm('¿Eliminar este requisito?')">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-page="/Puestos/Index" class="btn btn-secondary">Regresar</a>

</div>
