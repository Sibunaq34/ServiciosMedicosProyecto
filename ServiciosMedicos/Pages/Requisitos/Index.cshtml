@page "{idPuesto:int}"
@model ServiciosMedicos.Pages.Requisitos.IndexModel

@{
    ViewData["Title"] = "Requisitos";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-bold mb-1">Requisitos del Puesto</h2>
    <hr class="mb-3">

    <div class="d-flex gap-2 mb-3">
        <a asp-page="/Puestos/Index" class="btn btn-secondary">Regresar</a>
        <a asp-page="Create" asp-route-idPuesto="@Model.IdPuesto" class="btn btn-primary">Nuevo Requisito</a>
    </div>

    <table class="table table-bordered table-hover align-middle">
        <thead style="background-color:#1a2e42;">
            <tr>
                <th class="text-white">ID</th>
                <th class="text-white">Requisito</th>
                <th class="text-white">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ListaRequisitos)
            {
                <tr>
                    <td>@item.IdRequisito</td>
                    <td>@item.NombreRequisito</td>
                    <td>
                        <a asp-page="Edit"
                           asp-route-id="@item.IdRequisito"
                           asp-route-nombre="@item.NombreRequisito"
                           asp-route-idPuesto="@item.IdPuesto"
                           class="btn btn-sm me-1" style="background-color:#5BBFFF; color:#12375C;">
                            Editar
                        </a>
                        <button type="button"
                                class="btn btn-sm" style="background-color:#5BBFFF; color:#12375C;"
                                onclick="abrirModalEliminar(@item.IdRequisito, '@Html.Raw(item.NombreRequisito)')">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
            @if (!Model.ListaRequisitos.Any())
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">No hay requisitos registrados.</td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPaginas > 1)
    {
        <nav>
            <ul class="pagination">
                <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-page="Index"
                       asp-route-idPuesto="@Model.IdPuesto"
                       asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                </li>
                <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link"
                       asp-page="Index"
                       asp-route-idPuesto="@Model.IdPuesto"
                       asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>

<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Realmente desea eliminar el elemento seleccionado?
                <p class="fw-semibold mt-2 mb-0" id="nombreRequisito"></p>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar" id="formEliminar">
                    <input type="hidden" name="id" id="idEliminar" />
                    <input type="hidden" name="idPuesto" value="@Model.IdPuesto" />
                    <button type="submit" class="btn btn-danger">Sí</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.Mensaje != null)
{
    <div class="modal fade" id="modalResultado" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header @(Model.TipoMensaje == "success" ? "bg-success" : "bg-danger") text-white">
                    <h5 class="modal-title">@(Model.TipoMensaje == "success" ? "Operación exitosa" : "Mensaje del sistema")</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">@Model.Mensaje</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function abrirModalEliminar(id, nombre) {
            document.getElementById('idEliminar').value = id;
            document.getElementById('nombreRequisito').textContent = nombre;
            new bootstrap.Modal(document.getElementById('modalEliminar')).show();
        }

        @if (Model.Mensaje != null)
        {
            <text>
            window.addEventListener('load', function () {
                new bootstrap.Modal(document.getElementById('modalResultado')).show();
            });
            </text>
        }
    </script>
}
