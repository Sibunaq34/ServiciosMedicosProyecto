@page "{idPuesto:int}"
@model ServiciosMedicos.Pages.Requisitos.CreateModel

@{
    ViewData["Title"] = "Nuevo Requisito";
}

<div class="container mt-4">

    <div class="card">
        <div class="card-header bg-success text-white">
            Nuevo Requisito
        </div>
        <div class="card-body">
            <form method="post">
                <input asp-for="Requisito.IdPuesto" type="hidden" />
                <div class="mb-3">
                    <label>Nombre del requisito</label>
                    <input asp-for="Requisito.NombreRequisito"
                           maxlength="100"
                           class="form-control" />
                </div>
                <button type="submit" class="btn btn-success">
                    Guardar
                </button>
                <a asp-page="Index" asp-route-idPuesto="@Model.Requisito.IdPuesto" class="btn btn-secondary">
                    Regresar
                </a>
            </form>
        </div>
    </div>

</div>
