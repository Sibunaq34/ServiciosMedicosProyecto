@page
@model ServiciosMedicos.Pages.Oferentes.PreparacionAcademica.IndexModel
@{
    ViewData["Title"] = "Preparacion Academica";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-bold mb-1">Preparacion Academica</h2>
    @if (Model.Oferente != null)
    {
        <p class="text-muted mb-1">@Model.Oferente.Identificacion — @Model.Oferente.NombreCompleto</p>
    }
    <hr class="mb-3">

    <div class="d-flex gap-2 mb-3">
        <a class="btn btn-secondary" asp-page="/Oferentes/Index">Regresar</a>
        <a class="btn btn-primary"
           asp-page="./Crear"
           asp-route-idOferente="@Model.IdOferente">
            Nuevo
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
    {
        <div class="alert alert-success" role="alert">
            @Model.MensajeExito
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="alert alert-danger" role="alert">
            @Model.MensajeError
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="page-thead">
                <tr>
                    <th scope="col">Institucion educativa</th>
                    <th scope="col">Titulo obtenido</th>
                    <th scope="col">Fecha inicio</th>
                    <th scope="col">Fecha fin</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Preparaciones.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            No hay preparacion academica registrada para este oferente.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var preparacion in Model.Preparaciones)
                    {
                        var modalId = $"eliminarPreparacion{preparacion.IdPreparacion}";

                        <tr>
                            <td>@preparacion.CodigoInstitucion - @preparacion.NombreInstitucion</td>
                            <td>@preparacion.Titulo</td>
                            <td>@preparacion.FechaInicio?.ToString("yyyy-MM-dd")</td>
                            <td>@preparacion.FechaFin?.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">
                                <a class="btn btn-sm me-1 text-white" style="background-color:#1D6FA4;"
                                   asp-page="./Editar"
                                   asp-route-id="@preparacion.IdPreparacion">
                                    Editar
                                </a>
                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#@modalId">
                                    Eliminar
                                </button>

                                <div class="modal fade"
                                     id="@modalId"
                                     tabindex="-1"
                                     aria-labelledby="@($"{modalId}Titulo")"
                                     aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content text-start">
                                            <div class="modal-header">
                                                <h2 class="modal-title h5" id="@($"{modalId}Titulo")">
                                                    Confirmar eliminacion
                                                </h2>
                                                <button type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="modal"
                                                        aria-label="Cerrar">
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                ¿Realmente desea eliminar el elemento seleccionado?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button"
                                                        class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                    No
                                                </button>
                                                <form method="post"
                                                      asp-page-handler="Eliminar"
                                                      asp-route-idPreparacion="@preparacion.IdPreparacion"
                                                      asp-route-idOferente="@Model.IdOferente"
                                                      asp-route-pagina="@Model.Pagina">
                                                    <button type="submit" class="btn btn-danger">
                                                        Si
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Paginacion de preparacion academica">
        <ul class="pagination">
            <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-idOferente="@Model.IdOferente"
                   asp-route-pagina="@(Model.Pagina - 1)">
                    Anterior
                </a>
            </li>
            <li class="page-item active" aria-current="page">
                <span class="page-link">@Model.Pagina</span>
            </li>
            <li class="page-item @(Model.HaySiguientePagina ? "" : "disabled")">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-idOferente="@Model.IdOferente"
                   asp-route-pagina="@(Model.Pagina + 1)">
                    Siguiente
                </a>
            </li>
        </ul>
    </nav>
</div>
