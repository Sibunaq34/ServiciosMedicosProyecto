@page
@model ServiciosMedicos.Pages.Oferentes.IndexModel
@{
    ViewData["Title"] = "Oferentes";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-bold mb-1">Oferentes</h2>
    <hr class="mb-3">

    <a class="btn btn-primary mb-3" asp-page="./Crear">Nuevo</a>

    @if (!string.IsNullOrWhiteSpace(Model.MensajeExito))
    {
        <div class="alert alert-success" role="alert">
            @Model.MensajeExito
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MensajeError))
    {
        <div class="alert alert-danger" role="alert">
            @Model.MensajeError
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="page-thead">
                <tr>
                    <th scope="col">Identificacion</th>
                    <th scope="col">Tipo</th>
                    <th scope="col">Nombre completo</th>
                    <th scope="col">Fecha nacimiento</th>
                    <th scope="col">Correos</th>
                    <th scope="col">Telefonos</th>
                    <th scope="col">Concursos</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Oferentes.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">
                            No hay oferentes registrados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var oferente in Model.Oferentes)
                    {
                        var modalId = $"eliminarOferente{oferente.IdOferente}";

                        <tr>
                            <td>@oferente.Identificacion</td>
                            <td>@Model.ObtenerTextoTipoIdentificacion(oferente.TipoIdentificacion)</td>
                            <td>@oferente.NombreCompleto</td>
                            <td>@oferente.FechaNacimiento.ToString("yyyy-MM-dd")</td>
                            <td>@string.Join(", ", oferente.Correos)</td>
                            <td>@string.Join(", ", oferente.Telefonos)</td>
                            <td>@string.Join(", ", oferente.Concursos.Select(concurso => concurso.Nombre))</td>
                            <td class="text-end">
                                <a class="btn btn-sm me-1 text-white" style="background-color:#1D6FA4;"
                                   asp-page="./Editar"
                                   asp-route-id="@oferente.IdOferente">
                                    Editar
                                </a>
                                <a class="btn btn-sm btn-secondary"
                                   asp-page="./PreparacionAcademica/Index"
                                   asp-route-idOferente="@oferente.IdOferente">
                                    Preparacion academica
                                </a>
                                <button type="button"
                                        class="btn btn-danger btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#@modalId">
                                    Eliminar
                                </button>

                                <div class="modal fade"
                                     id="@modalId"
                                     tabindex="-1"
                                     aria-labelledby="@($"{modalId}Titulo")"
                                     aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content text-start">
                                            <div class="modal-header">
                                                <h2 class="modal-title h5" id="@($"{modalId}Titulo")">
                                                    Confirmar eliminacion
                                                </h2>
                                                <button type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="modal"
                                                        aria-label="Cerrar">
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                ¿Realmente desea eliminar el elemento seleccionado?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button"
                                                        class="btn btn-secondary"
                                                        data-bs-dismiss="modal">
                                                    No
                                                </button>
                                                <form method="post"
                                                      asp-page-handler="Eliminar"
                                                      asp-route-idOferente="@oferente.IdOferente"
                                                      asp-route-pagina="@Model.Pagina">
                                                    <button type="submit" class="btn btn-danger">
                                                        Sí
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Paginacion de oferentes">
        <ul class="pagination">
            <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-pagina="@(Model.Pagina - 1)">
                    Anterior
                </a>
            </li>
            <li class="page-item active" aria-current="page">
                <span class="page-link">@Model.Pagina</span>
            </li>
            <li class="page-item @(Model.HaySiguientePagina ? "" : "disabled")">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-pagina="@(Model.Pagina + 1)">
                    Siguiente
                </a>
            </li>
        </ul>
    </nav>
</div>
