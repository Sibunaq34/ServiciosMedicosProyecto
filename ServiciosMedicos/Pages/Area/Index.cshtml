@page
@model ServiciosMedicos.Pages.Area.IndexModel
@{
    ViewData["Title"] = "Administración de Áreas";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-bold mb-1">Administración de Áreas</h2>
    <hr class="mb-3">

    <a class="btn btn-primary mb-3" asp-page="Crear">Nuevo</a>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead style="background-color:#1a2e42;">
                <tr>
                    <th class="text-white">Código</th>
                    <th class="text-white">Nombre Área</th>
                    <th class="text-white">Empleado</th>
                    <th class="text-white">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var area in Model.Areas)
                {
                    <tr>
                        <td>@area.CodigoArea</td>
                        <td>@area.NombreArea</td>
                        <td>@area.NombreEmpleado</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <a class="btn btn-sm" style="background-color:#5BBFFF; color:#12375C;"
                                   asp-page="Editar"
                                   asp-route-id="@area.IdArea">Editar</a>
                                <button class="btn btn-sm" style="background-color:#5BBFFF; color:#12375C;"
                                        onclick="confirmarEliminar(@area.IdArea)">Eliminar</button>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Areas.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted">No hay áreas registradas.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav>
            <ul class="pagination">
                <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="Index" asp-route-pagina="@(Model.PaginaActual - 1)">Anterior</a>
                </li>
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" asp-page="Index" asp-route-pagina="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-page="Index" asp-route-pagina="@(Model.PaginaActual + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Modal confirmación eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Realmente desea eliminar el elemento seleccionado?
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar">
                    <input type="hidden" name="id" id="idEliminar" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal resultado -->
@if (Model.Mensaje != null)
{
    <div class="modal fade" id="modalResultado" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-@Model.TipoMensaje text-white">
                    <h5 class="modal-title">@(Model.TipoMensaje == "success" ? "Éxito" : "Error")</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">@Model.Mensaje</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function confirmarEliminar(id) {
            document.getElementById('idEliminar').value = id;
            new bootstrap.Modal(document.getElementById('modalEliminar')).show();
        }

        @if (Model.Mensaje != null)
        {
            <text>
            window.addEventListener('load', function () {
                new bootstrap.Modal(document.getElementById('modalResultado')).show();
            });
            </text>
        }
    </script>
}
