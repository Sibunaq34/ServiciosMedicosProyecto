@page
@model ServiciosMedicos.Pages.Gerente.BitacoraModel

@{
    ViewData["Title"] = "Bitácora";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-bold mb-1">Bitácora de Auditoría</h2>
    <hr class="mb-3">

    <form method="get" class="row g-3 mb-3">
        <div class="col-md-3">
            <label class="form-label">Usuario</label>
            <input type="text" name="usuario" value="@Request.Query["usuario"]"
                   class="form-control" placeholder="Buscar usuario">
        </div>
        <div class="col-md-4">
            <label class="form-label">Descripción</label>
            <input type="text" name="descripcion" value="@Request.Query["descripcion"]"
                   class="form-control" placeholder="Buscar acción realizada">
        </div>
        <div class="col-md-3">
            <label class="form-label">Ordenar por</label>
            <select class="form-select">
                <option>Fecha Ascendente</option>
                <option selected>Fecha Descendente</option>
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Buscar</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead style="background-color:#1a2e42;">
                <tr>
                    <th class="text-white" style="width:20%">Fecha</th>
                    <th class="text-white" style="width:20%">Usuario</th>
                    <th class="text-white" style="width:60%">Descripción de la Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Bitacoras != null && Model.Bitacoras.Any())
                {
                    @foreach (var item in Model.Bitacoras)
                    {
                        <tr>
                            <td>@item.FechaBitacora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.Usuario</td>
                            <td>@item.Accion</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">No se encontraron registros.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-2">
        <span class="text-muted small">Registros encontrados: @Model.Bitacoras.Count</span>
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item disabled"><span class="page-link">Anterior</span></li>
                <li class="page-item active"><span class="page-link">1</span></li>
                <li class="page-item disabled"><span class="page-link">Siguiente</span></li>
            </ul>
        </nav>
    </div>
</div>
