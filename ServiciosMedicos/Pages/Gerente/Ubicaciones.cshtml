@page
@model ServiciosMedicos.Pages.Ubicaciones.UbicacionesModel

@{
    ViewData["Title"] = "Carga de Ubicaciones";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-bold mb-1">Carga de Datos de Ubicación</h2>
    <hr class="mb-3">

    <div class="row">
        <div class="col-lg-6">
            <form method="post" enctype="multipart/form-data" class="row g-3">
                <div class="col-12">
                    <label asp-for="Archivo" class="form-label">Seleccione el archivo</label>
                    <input asp-for="Archivo" type="file" class="form-control" accept=".xlsx,.xls" />
                    <div class="form-text">Formatos permitidos: Excel (.xlsx, .xls)</div>
                </div>
                <div class="col-12">
                    <button type="subir" class="btn btn-primary">Cargar Información</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="mensajeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <h5 class="modal-title text-danger">Error</h5>
                }
                else
                {
                    <h5 class="modal-title text-success">Resultado</h5>
                }
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(Model.Mensaje))
                {
                    <div class="alert alert-success mb-0">
                        <i class="bi bi-check-circle me-2"></i>@Model.Mensaje
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>@Model.Error
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje) || !string.IsNullOrEmpty(Model.Error))
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var modal = new bootstrap.Modal(document.getElementById('mensajeModal'));
            modal.show();
        });
    </script>
}
