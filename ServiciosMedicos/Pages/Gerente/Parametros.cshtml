@page
@model ServiciosMedicos.Pages.Parametros.ParametrosModel

@{
    ViewData["Title"] = "Parámetros";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-bold mb-1">Administración de Parámetros</h2>
    <hr class="mb-3">

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row mb-4">
        <div class="col-lg-6">
            <form method="post" class="row g-3">
                <input type="hidden" asp-for="Parametro.IdParametro" />

                <div class="col-12">
                    <label asp-for="Parametro.CodigoParametro" class="form-label">Código del Parámetro</label>
                    <input asp-for="Parametro.CodigoParametro" class="form-control" />
                    <span asp-validation-for="Parametro.CodigoParametro" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Parametro.Valor" class="form-label">Valor</label>
                    <textarea asp-for="Parametro.Valor" class="form-control" maxlength="500" rows="4"></textarea>
                    <span asp-validation-for="Parametro.Valor" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <button type="submit" asp-page-handler="Guardar" class="btn btn-success">
                        @(Model.Parametro.IdParametro == 0 ? "Guardar" : "Actualizar")
                    </button>
                </div>
            </form>
        </div>
    </div>

    <hr class="mb-3">

    <table class="table table-bordered table-hover align-middle">
        <thead style="background-color:#1a2e42;">
            <tr>
                <th class="text-white">ID</th>
                <th class="text-white">Código</th>
                <th class="text-white">Valor</th>
                <th class="text-white" style="width:160px">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ListaParametros)
            {
                <tr>
                    <td>@item.IdParametro</td>
                    <td>@item.CodigoParametro</td>
                    <td>@item.Valor</td>
                    <td>
                        <a asp-page="./Parametros"
                           asp-route-id="@item.IdParametro"
                           class="btn btn-sm me-1" style="background-color:#5BBFFF; color:#12375C;">
                            Editar
                        </a>
                        <form method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.IdParametro" />
                            <button type="button"
                                    class="btn btn-sm" style="background-color:#5BBFFF; color:#12375C;"
                                    onclick="abrirModal(@item.IdParametro)">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">¿Desea eliminar este parámetro?</div>
            <div class="modal-footer">
                <form method="post">
                    <input type="hidden" id="idEliminar" name="id" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" asp-page-handler="Eliminar" class="btn btn-danger">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function abrirModal(id) {
            document.getElementById("idEliminar").value = id;
            var modal = new bootstrap.Modal(document.getElementById("modalEliminar"));
            modal.show();
        }
    </script>
}
