@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    int? idRol =
        HttpContextAccessor.HttpContext?.Session.GetInt32("IdRol");
    string? usuario = 
        HttpContextAccessor.HttpContext?.Session.GetString("NombreUsuario");
    var ruta =
    Context.Request.Path.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ServiciosMedicos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ServiciosMedicos.styles.css" asp-append-version="true" />
</head>
<body>
    @if (ruta != "/LogIn")
        {
            <header>

                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                    <div class="container">
                        <a class="navbar-brand" asp-area="" asp-page="/Index">Bienvenido @usuario</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-page="/Index">Inicio</a>
                                </li>
                                @if (idRol == 1)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="">Usuarios</a>
                                        <ul>   
                                            <li><a asp-area=" " asp-page="">Administrar Usuarios</a></li>
                                            <li><a asp-area="" asp-page="">Gestion Rol</a></li>
                                        </ul>
                                    </li>
                                    <li class="nav-item">   
                                        <a class="nav-link text-dark" asp-area="" asp-page="">Parametros</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="">Pantalla</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="/Gerente/bitacora">Bitacora</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="/Gerente/Ubicaciones">Cargar Datos de Ubicacion</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="/Compania/Index">Compañías</a>
                                    </li>
                                }
                                @if (idRol == 2)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="">Oferentes</a>
                                        <ul>
                                            <li><a asp-area="" asp-page="">Registrar Oferentes</a></li>
                                        </ul>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="">Concursos</a>
                                        <ul>
                                            <li><a asp-area="" asp-page="">Registrar Concurso</a></li>
                                        </ul>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="/Entrevista/Index">Agendar Entrevistas</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="">Contratar Empleado</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="">Puestos</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="/Area/Index">Áreas</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="">Acciones de Personal</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-page="">Instituciones Educativas</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>
        }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ServiciosMedicos - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>
    <div class="modal fade"
         id="modalInactividad"
         tabindex="-1"
         data-bs-backdrop="static"
         data-bs-keyboard="false">

        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title">
                        Sesión Expirada
                    </h5>

                </div>
                <div class="modal-body">
                    <p>  Su sesión fue cerrada por inactividad.</p>
                    <p>Debe iniciar sesión nuevamente para continuar.</p>
                </div>

                <div class="modal-footer">
                    <button type="button" id="btnLogin"class="btn btn-primary">Iniciar Sesion</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>

        let tiempoInactividad;

        function reiniciarTemporizador()
        {
        clearTimeout(tiempoInactividad);

        tiempoInactividad = setTimeout(function ()
        {
        var modal = new bootstrap.Modal(
        document.getElementById('modalInactividad')
        );

        modal.show();

        }, 300000);
        }

        document.addEventListener(
        "mousemove",
        reiniciarTemporizador
        );

        document.addEventListener(
        "keypress",
        reiniciarTemporizador
        );

        document.addEventListener(
        "click",
        reiniciarTemporizador
        );

        document.addEventListener(
        "scroll",
        reiniciarTemporizador
        );

        document.addEventListener(
        "DOMContentLoaded",
        function ()
        {
        reiniciarTemporizador();

        document.getElementById("btnLogin")
        .addEventListener(
        "click",
        function ()
        {
        window.location.href =
        "/LogIn?expirada=true";
        });
        });

    </script>
    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>