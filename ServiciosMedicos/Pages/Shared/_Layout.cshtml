@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    string? usuario =
        HttpContextAccessor.HttpContext?.Session.GetString("NombreUsuario");

    var pantallas =
        HttpContextAccessor.HttpContext?.Session.GetString("PantallasRol") ?? "";

    bool TienePantalla(string nombre)
    {
        return pantallas.Split('|').Contains(nombre);
    }

    var ruta = Context.Request.Path.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ServiciosMedicos</title>
    <link rel="icon" type="image/svg+xml" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/heart-pulse-fill.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ServiciosMedicos.styles.css" asp-append-version="true" />
    <style>
        #sidebar { transition: width 0.25s ease; }
        #sidebar .sidebar-link:hover { background-color: rgba(255,255,255,0.08) !important; }

        @@media (max-width: 767.98px) {
            #sidebar {
                position: fixed !important;
                top: 0 !important;
                left: 0 !important;
                width: 230px !important;
                height: 100dvh !important;
                transform: translateX(-100%);
                transition: transform 0.25s ease !important;
                z-index: 1045;
            }

            #sidebar.sidebar-mobile-open {
                transform: translateX(0);
                box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.25);
            }

            .app-topbar {
                padding-left: 1rem !important;
                padding-right: 1rem !important;
            }

            .app-page-body {
                padding: 1rem !important;
                width: 100%;
                max-width: 100vw;
                overflow-x: hidden;
            }

            .app-page-body .container-fluid {
                padding-left: 0 !important;
                padding-right: 0 !important;
            }

            .app-page-body .table-responsive {
                width: 100%;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
        }

        #sidebar-backdrop {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 1040;
        }
    </style>
</head>
<body>
<div class="d-flex" style="min-height:100vh;">

    @if (ruta != "/LogIn")
    {
        <!-- SIDEBAR -->
        <div id="sidebar"
             class="d-flex flex-column"
             style="width:230px; height:100vh; background-color:#12375C; flex-shrink:0; position:sticky; top:0; overflow:hidden;">

            <!-- Brand Header -->
            <div class="d-flex align-items-center px-2 py-3"
                 style="border-bottom:1px solid rgba(255,255,255,0.12); flex-shrink:0; min-height:60px;">
                <div class="d-flex align-items-center justify-content-center rounded-circle"
                     style="width:36px; height:36px; background-color:#1D6FA4; flex-shrink:0;">
                    <i class="bi bi-heart-pulse-fill text-white" style="font-size:1rem;"></i>
                </div>
                <span id="brand-label"
                      class="nav-label ms-2 text-white fw-semibold"
                      style="font-size:0.9rem; white-space:nowrap;">Servicios Médicos</span>
            </div>

            <!-- Scrollable Nav -->
            <div class="flex-grow-1" style="overflow-y:auto; overflow-x:hidden;">
                <nav class="nav nav-pills flex-column mt-1 px-2 pb-2">

                    @if (TienePantalla("Inicio"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/Index"
                           style="color:#B8CDE0;">
                            <i class="bi bi-house" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Inicio</span>
                        </a>
                    }

                    @if (TienePantalla("Usuarios"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/Usuarios/Index"
                           style="color:#B8CDE0;">
                            <i class="bi bi-people" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Usuarios</span>
                        </a>
                    }

                    @if (TienePantalla("Roles"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/Roles/Index"
                           style="color:#B8CDE0;">
                            <i class="bi bi-shield" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Roles</span>
                        </a>
                    }

                    @if (TienePantalla("Pantallas"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/Pantallas/Index"
                           style="color:#B8CDE0;">
                            <i class="bi bi-display" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Pantallas</span>
                        </a>
                    }

                    @if (TienePantalla("Parámetros"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/Gerente/Parametros"
                           style="color:#B8CDE0;">
                            <i class="bi bi-sliders" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Parámetros</span>
                        </a>
                    }

                    @if (TienePantalla("Bitácora"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/Gerente/bitacora"
                           style="color:#B8CDE0;">
                            <i class="bi bi-journal-text" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Bitácora</span>
                        </a>
                    }

                    @if (TienePantalla("Cargar Datos de Ubicación"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/Gerente/Ubicaciones"
                           style="color:#B8CDE0;">
                            <i class="bi bi-geo-alt" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Ubicaciones</span>
                        </a>
                    }

                    @if (TienePantalla("Compañías"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/Compania/Index"
                           style="color:#B8CDE0;">
                            <i class="bi bi-building" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Compañías</span>
                        </a>
                    }

                    @if (TienePantalla("Oferentes"))
                    {
                        <div class="my-1">
                            <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 rounded-2"
                               data-bs-toggle="collapse"
                               href="#submenuOferentes"
                               role="button"
                               aria-expanded="false"
                               aria-controls="submenuOferentes"
                               style="color:#B8CDE0; cursor:pointer;">
                                <i class="bi bi-person" style="font-size:1.1rem; flex-shrink:0;"></i>
                                <span class="nav-label d-flex align-items-center flex-grow-1" style="white-space:nowrap;">
                                    Oferentes
                                    <i class="bi bi-chevron-down ms-auto" style="font-size:0.75rem;"></i>
                                </span>
                            </a>
                            <div class="collapse" id="submenuOferentes">
                                <div class="ps-3">
                                    <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-1 rounded-2"
                                       asp-page="/Oferentes/Index"
                                       style="color:#B8CDE0; font-size:0.875rem;">
                                        <i class="bi bi-person-lines-fill" style="font-size:0.9rem; flex-shrink:0;"></i>
                                        <span class="nav-label" style="white-space:nowrap;">Ver Oferentes</span>
                                    </a>
                                    <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-1 rounded-2"
                                       asp-page="/Oferentes/Create"
                                       style="color:#B8CDE0; font-size:0.875rem;">
                                        <i class="bi bi-person-plus" style="font-size:0.9rem; flex-shrink:0;"></i>
                                        <span class="nav-label" style="white-space:nowrap;">Registrar Oferentes</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    @if (TienePantalla("Concursos"))
                    {
                        <div class="my-1">
                            <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 rounded-2"
                               data-bs-toggle="collapse"
                               href="#submenuConcursos"
                               role="button"
                               aria-expanded="false"
                               aria-controls="submenuConcursos"
                               style="color:#B8CDE0; cursor:pointer;">
                                <i class="bi bi-file-text" style="font-size:1.1rem; flex-shrink:0;"></i>
                                <span class="nav-label d-flex align-items-center flex-grow-1" style="white-space:nowrap;">
                                    Concursos
                                    <i class="bi bi-chevron-down ms-auto" style="font-size:0.75rem;"></i>
                                </span>
                            </a>
                            <div class="collapse" id="submenuConcursos">
                                <div class="ps-3">
                                    <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-1 rounded-2"
                                       asp-page="/Concursos/Index"
                                       style="color:#B8CDE0; font-size:0.875rem;">
                                        <i class="bi bi-file-earmark-text" style="font-size:0.9rem; flex-shrink:0;"></i>
                                        <span class="nav-label" style="white-space:nowrap;">Ver Concursos</span>
                                    </a>
                                    <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-1 rounded-2"
                                       asp-page="/Concursos/Create"
                                       style="color:#B8CDE0; font-size:0.875rem;">
                                        <i class="bi bi-file-earmark-plus" style="font-size:0.9rem; flex-shrink:0;"></i>
                                        <span class="nav-label" style="white-space:nowrap;">Registrar Concurso</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    @if (TienePantalla("Agendar Entrevistas"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/Entrevista/Index"
                           style="color:#B8CDE0;">
                            <i class="bi bi-calendar-event" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Agendar Entrevistas</span>
                        </a>
                    }

                    @if (TienePantalla("Contratar Empleado"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/Empleados/ContratarEmpleado"
                           style="color:#B8CDE0;">
                            <i class="bi bi-person-check" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Contratar Empleado</span>
                        </a>
                    }

                    @if (TienePantalla("Puestos"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/Puestos/Index"
                           style="color:#B8CDE0;">
                            <i class="bi bi-briefcase" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Puestos</span>
                        </a>
                    }

                    @if (TienePantalla("Áreas"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/Area/Index"
                           style="color:#B8CDE0;">
                            <i class="bi bi-grid" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Áreas</span>
                        </a>
                    }

                    @if (TienePantalla("Acciones de Personal"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/AccionesPersonal/Index"
                           style="color:#B8CDE0;">
                            <i class="bi bi-list-ul" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Acciones de Personal</span>
                        </a>
                    }

                    @if (TienePantalla("Requisitos"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/Requisitos/Index"
                           style="color:#B8CDE0;">
                            <i class="bi bi-clipboard-check" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Requisitos de Puestos</span>
                        </a>
                    }

                    @if (TienePantalla("Instituciones Educativas"))
                    {
                        <a class="nav-link sidebar-link d-flex align-items-center gap-2 py-2 my-1 rounded-2"
                           asp-page="/InstitucionesEducativas/Index"
                           style="color:#B8CDE0;">
                            <i class="bi bi-mortarboard" style="font-size:1.1rem; flex-shrink:0;"></i>
                            <span class="nav-label" style="white-space:nowrap;">Instituciones Educativas</span>
                        </a>
                    }

                </nav>
            </div>

            <!-- Toggle Button -->
            <div class="px-2 py-2" style="border-top:1px solid rgba(255,255,255,0.12); flex-shrink:0;">
                <button onclick="toggleSidebar()"
                        class="btn w-100 d-flex align-items-center justify-content-center py-1"
                        style="color:#B8CDE0; background:transparent; border:1px solid rgba(184,205,224,0.3);">
                    <i id="toggleIcon" class="bi bi-layout-sidebar-reverse" style="font-size:1.1rem;"></i>
                    <span id="toggleLabel" class="nav-label ms-2" style="font-size:0.8rem; white-space:nowrap;">Contraer</span>
                </button>
            </div>

        </div>
    }

    <!-- MAIN CONTENT -->
    <div class="d-flex flex-column flex-grow-1" style="min-width:0; background-color:#f8f9fa;">

        @if (ruta != "/LogIn")
        {
            <!-- Topbar -->
            <div class="app-topbar d-flex align-items-center justify-content-between px-4 py-2 bg-white border-bottom"
                style="flex-shrink:0; min-height:52px;">
                <div class="d-flex align-items-center gap-2">
                    <button class="d-md-none btn p-0 border-0" id="btnHamburger" style="color:#12375C; background:none; line-height:1;">
                        <i class="bi bi-list" style="font-size:1.5rem;"></i>
                    </button>
                    <span class="fw-semibold" style="color:#12375C;">ServiciosMedicos</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="small" style="color:#12375C;">
                        <i class="bi bi-person-circle me-1"></i>@usuario
                    </span>
                    <a asp-page="/Logout"
                       class="btn btn-sm d-flex align-items-center gap-1"
                       style="color:#12375C; border:1px solid #12375C;">
                        <i class="bi bi-box-arrow-right"></i>
                        <span class="d-none d-sm-inline">Cerrar Sesión</span>
                    </a>
                </div>
            </div>
        }

        <!-- Page Body -->
        <div class="app-page-body flex-grow-1 p-4">
            <main role="main">
                @RenderBody()
            </main>
        </div>

        @if (ruta != "/LogIn")
        {
            <footer class="border-top py-2 px-4 bg-white" style="flex-shrink:0;">
                <small class="text-muted">
                    &copy; 2026 - ServiciosMedicos - <a asp-area="" asp-page="/Privacy">Privacy</a>
                </small>
            </footer>
        }

    </div>
</div>
    <!--SEG4,5,6-->
    @if (TempData["Mensaje"] != null)
    {
        <input type="hidden" id="mensajeSistema" value="@TempData["Mensaje"]" data-tipo="exito" />
    }

    @if (TempData["Error"] != null)
    {
        <input type="hidden" id="mensajeSistema" value="@TempData["Error"]" data-tipo="error" />
    }

    @if (TempData["Validacion"] != null)
    {
        <input type="hidden" id="mensajeSistema" value="@TempData["Validacion"]" data-tipo="validacion" />
    }

    <div class="modal fade" id="modalMensajeSistema" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div id="modalMensajeHeader" class="modal-header">
                    <h5 id="modalMensajeTitulo" class="modal-title">Mensaje</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <p id="modalMensajeTexto"></p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                        Aceptar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalConfirmacionSistema" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning">
                    <h5 class="modal-title" id="tituloConfirmacion">
                        Confirmar Acción
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">
                    <p id="mensajeConfirmacion"></p>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="button"
                            id="btnConfirmarSistema"
                            class="btn btn-danger">
                        Confirmar
                    </button>
                </div>
            </div>
        </div>
    </div>
<!-- Inactivity Modal -->
<div class="modal fade"
     id="modalInactividad"
     tabindex="-1"
     data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">Sesión Expirada</h5>
            </div>
            <div class="modal-body">
                <p>Su sesión fue cerrada por inactividad.</p>
                <p>Debe iniciar sesión nuevamente para continuar.</p>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnLogin" class="btn btn-primary">Iniciar Sesion</button>
            </div>
        </div>
    </div>
</div>

<div id="sidebar-backdrop" onclick="closeMobileSidebar()"></div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
        document.addEventListener('DOMContentLoaded', function () {
        var mensaje = document.getElementById('mensajeSistema');

        if (mensaje) {
        var texto = mensaje.value;
        var tipo = mensaje.getAttribute('data-tipo');

        var titulo = document.getElementById('modalMensajeTitulo');
        var cuerpo = document.getElementById('modalMensajeTexto');
        var header = document.getElementById('modalMensajeHeader');

        cuerpo.innerText = texto;

        if (tipo === 'exito') {
        titulo.innerText = 'Operación Exitosa';
        header.className = 'modal-header bg-success text-white';
        }
        else if (tipo === 'validacion') {
        titulo.innerText = 'Validación';
        header.className = 'modal-header bg-warning';
        }
        else {
        titulo.innerText = 'Error';
        header.className = 'modal-header bg-danger text-white';
        }

        var modal = new bootstrap.Modal(document.getElementById('modalMensajeSistema'));
        modal.show();
        }

        let formularioConfirmacion = null;

        document.querySelectorAll('.requiere-confirmacion')
        .forEach(function (btn) {
        btn.addEventListener('click', function (e) {
        e.preventDefault();

        formularioConfirmacion = btn.closest('form');

        document.getElementById('tituloConfirmacion').innerText =
        btn.dataset.titulo;

        document.getElementById('mensajeConfirmacion').innerText =
        btn.dataset.mensaje;

        var modalConfirmacion = new bootstrap.Modal(
        document.getElementById('modalConfirmacionSistema')
        );

        modalConfirmacion.show();
        });
        });

        var btnConfirmar = document.getElementById('btnConfirmarSistema');

        if (btnConfirmar) {
        btnConfirmar.addEventListener('click', function () {
        if (formularioConfirmacion) {
        formularioConfirmacion.submit();
        }
        });
        }
        });
    // ── Inactivity Timer ─────────────────────────────────────────────────
    let tiempoInactividad;

    function reiniciarTemporizador() {
        clearTimeout(tiempoInactividad);
        tiempoInactividad = setTimeout(function () {
            var modal = new bootstrap.Modal(document.getElementById('modalInactividad'));
            modal.show();
        }, 300000);
    }

    ['mousemove', 'keypress', 'click', 'scroll'].forEach(function (evt) {
        document.addEventListener(evt, reiniciarTemporizador);
    });

    document.addEventListener('DOMContentLoaded', function () {
        reiniciarTemporizador();
        var btnLogin = document.getElementById('btnLogin');
        if (btnLogin) {
            btnLogin.addEventListener('click', function () {
                window.location.href = '/LogIn?expirada=true';
            });
        }

        // ── Active item detection ─────────────────────────────────────────
        var currentUrl = window.location.href;
        document.querySelectorAll('#sidebar a.sidebar-link').forEach(function (link) {
            if (link.href === currentUrl) {
                link.style.backgroundColor = '#1D6FA4';
                link.style.borderLeft = '3px solid #5BBFFF';
                link.style.color = '#ffffff';

                var parentCollapse = link.closest('.collapse');
                if (parentCollapse) {
                    parentCollapse.classList.add('show');
                    var trigger = document.querySelector(
                        '[data-bs-toggle="collapse"][href="#' + parentCollapse.id + '"]'
                    );
                    if (trigger) trigger.setAttribute('aria-expanded', 'true');
                }
            }
        });
    });

    // ── Mobile Sidebar ────────────────────────────────────────────────────
    var hamburger = document.getElementById('btnHamburger');
    if (hamburger) {
        hamburger.addEventListener('click', function () {
            var sidebar = document.getElementById('sidebar');
            var backdrop = document.getElementById('sidebar-backdrop');
            if (sidebar) sidebar.classList.add('sidebar-mobile-open');
            if (backdrop) backdrop.style.display = 'block';
        });
    }

    function closeMobileSidebar() {
        var sidebar = document.getElementById('sidebar');
        var backdrop = document.getElementById('sidebar-backdrop');
        if (sidebar) sidebar.classList.remove('sidebar-mobile-open');
        if (backdrop) backdrop.style.display = 'none';
    }

    // ── Sidebar Toggle ────────────────────────────────────────────────────
    var sidebarExpanded = true;

    function toggleSidebar() {
        var sidebar = document.getElementById('sidebar');
        if (!sidebar) return;

        sidebarExpanded = !sidebarExpanded;

        var navLabels = sidebar.querySelectorAll('.nav-label');
        var toggleIcon = document.getElementById('toggleIcon');
        var toggleLabel = document.getElementById('toggleLabel');

        if (sidebarExpanded) {
            sidebar.style.width = '230px';
            navLabels.forEach(function (el) { el.style.display = ''; });
            if (toggleLabel) toggleLabel.textContent = 'Contraer';
            if (toggleIcon) toggleIcon.className = 'bi bi-layout-sidebar-reverse';
            sidebar.querySelectorAll('.nav-link').forEach(function (el) {
                el.style.justifyContent = '';
            });
        } else {
            sidebar.style.width = '58px';
            navLabels.forEach(function (el) { el.style.display = 'none'; });
            if (toggleIcon) toggleIcon.className = 'bi bi-layout-sidebar';
            sidebar.querySelectorAll('.nav-link').forEach(function (el) {
                el.style.justifyContent = 'center';
            });
        }
    }

    window.addEventListener('resize', function () {
        if (window.innerWidth >= 768) {
            closeMobileSidebar();
        }
    });
</script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
