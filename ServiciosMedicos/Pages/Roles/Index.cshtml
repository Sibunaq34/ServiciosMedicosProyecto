</div>

<div class="modal fade" id="modalEliminarRol" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <form method="post" asp-page-handler="Eliminar">

                <div class="modal-header bg-warning">
                    <h5 class="modal-title">
                        Confirmar Eliminación
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">
                    <input type="hidden"
                           id="idRolEliminar"
                           name="id" />

                    <p>
                        ¿Realmente desea eliminar el rol seleccionado?
                    </p>
                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        No
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Sí
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEliminarRol =
            document.getElementById('modalEliminarRol');

        if (modalEliminarRol) {

            modalEliminarRol.addEventListener(
                'show.bs.modal',
                function (event) {

                    const button =
                        event.relatedTarget;

                    const id =
                        button.getAttribute('data-id');

                    document.getElementById(
                        'idRolEliminar'
                    ).value = id;

                });
        }
    </script>
}