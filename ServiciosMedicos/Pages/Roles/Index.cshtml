@page
@model ServiciosMedicos.Pages.Roles.IndexModel

@{
    ViewData["Title"] = "Administración de Roles";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-bold mb-1">Administración de Roles</h2>
    <hr class="mb-3">

    <a asp-page="Crear" class="btn btn-primary mb-3">Nuevo Rol</a>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead style="background-color:#1a2e42;">
            <tr>
                <th class="text-white">ID</th>
                <th class="text-white">Nombre Rol</th>
                <th class="text-white">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.ListaRoles)
            {
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead style="background-color:#1a2e42;">
                <tr>
                    <td>@item.IdRol</td>
                    <td>@item.NombrePermiso</td>
                    <td>
                        <a asp-page="Editar"
                           asp-route-idRol="@item.IdRol"
                           class="btn btn-sm me-1" style="background-color:#5BBFFF; color:#12375C;">
                            Editar
                        </a>
                        <a asp-page="AsignarPantallas"
                           asp-route-idRol="@item.IdRol"
                           class="btn btn-secondary btn-sm me-1">
                            Pantallas
                        </a>
                        <form method="post"
                              asp-page-handler="Eliminar"
                              class="d-inline">
                            <input type="hidden" name="idRol" value="@item.IdRol" />
                            <button type="submit" class="btn btn-sm" style="background-color:#5BBFFF; color:#12375C;">
                                Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
                    <th class="text-white">ID</th>
                    <th class="text-white">Nombre Rol</th>
                    <th class="text-white">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.ListaRoles)
                {
                    <tr>
                        <td>@item.IdRol</td>
                        <td>@item.NombrePermiso</td>

                        <td>
                            <div class="d-flex flex-wrap gap-1">

                                <a asp-page="Editar"
                                   asp-route-idRol="@item.IdRol"
                                   class="btn btn-sm"
                                   style="background-color:#5BBFFF; color:#12375C;">
                                    Editar
                                </a>

                                <a asp-page="AsignarPantallas"
                                   asp-route-idRol="@item.IdRol"
                                   class="btn btn-secondary btn-sm">
                                    Pantallas
                                </a>

                                <button type="button"
                                        class="btn btn-sm"
                                        style="background-color:#5BBFFF; color:#12375C;"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEliminarRol"
                                        data-id="@item.IdRol">
                                    Eliminar
                                </button>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav>
        <ul class="pagination justify-content-start flex-wrap">
            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(i == Model.Pagina ? "active" : "")">
                    <a class="page-link" asp-route-Pagina="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
</div>
