@page "{idRol:int}"
@model ServiciosMedicos.Pages.Roles.AsignarPantallasModel

@{
    ViewData["Title"] = "Pantallas del Rol";
}

<div class="container-fluid px-4 py-4">
    <h2 class="fw-bold mb-1">Pantallas Asociadas al Rol</h2>
    <hr class="mb-3">

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead style="background-color:#1a2e42;">
                <tr>
                    <th class="text-white" style="width:100px;">ID</th>
                    <th class="text-white">Pantalla / Módulo</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var pantalla in Model.ListaPantallas)
                {
                    <tr>
                        <td>@pantalla.IdPantalla</td>
                        <td>@pantalla.NombrePantalla</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a asp-page="Index" class="btn btn-secondary">
        Regresar
    </a>
</div>